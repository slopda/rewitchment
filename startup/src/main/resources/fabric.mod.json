{
  "schemaVersion": 1,
  "id": "rewitchment",
  "version": "0.1.0-beta.2",
  "name": "Rewitchment",
  "description": "Automatic Bewitchment compatibility for Minecraft 1.21.1.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.veeda.rewitchment.startup.StartupRuntime"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21"
  },
  "mixins": [
    "rewitchment.mixins.json"
  ],
  "authors": [
    "veeda"
  ],
  "languageAdapters": {
    "rewitchment_startup": "com.veeda.rewitchment.startup.FabricStartupAdapter"
  },
  "jars": [
    {
      "file": "META-INF/jars/rewitchment-bewitchment-slot.jar"
    }
  ]
}